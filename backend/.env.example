# AI Provider configuration (openai, gemini, groq)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=
GROQ_API_KEY=your-groq-api-key-here
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=qwen/qwen3.6-27b
MODERATION_PROVIDER=auto
MODERATION_MODEL=omni-moderation-latest



# Routing and Threshold settings
REVIEW_THRESHOLD=0.75
MODERATION_THRESHOLD=0.7
MAX_IMAGE_DIMENSION=2048

# Storage and Database paths (Local Offline Fallback)
UPLOAD_DIR=uploads
DATABASE_PATH=data/cevondocs.db

# Supabase Managed Backend (PostgreSQL + CDN Object Storage)
# Set these to enable persistent cloud database & storage on Render / Vercel
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_STORAGE_BUCKET=cevondocs
SUPABASE_DOCUMENTS_TABLE=cevondocs_documents

# Configurable cost per token for cost metrics (e.g. gpt-4o price per token)
COST_PER_TOKEN=0.0000025

