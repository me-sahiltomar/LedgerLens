# ============================================================================
# LedgerLens (A CevonX Product) Frontend Configuration
# Target: Vercel Production Deployment
# ============================================================================

# Primary Canonical Website URL
NEXT_PUBLIC_SITE_URL=https://ledgerlens.cevonx.com

# Backend API Endpoint URL (Local or Render)
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Production Render Deployment:
# NEXT_PUBLIC_API_BASE_URL=https://ledgerlens-backend.onrender.com

# CevonX Products Central Supabase Platform (Project gzhiltwyuhclzbhaypzd in eu-central-1)
# Shared Auth & Multi-Product Database
NEXT_PUBLIC_SUPABASE_URL=https://gzhiltwyuhclzbhaypzd.supabase.co

# Client-safe Publishable Key (or legacy anon key)
# NEVER expose service role secrets (SUPABASE_SERVICE_ROLE_KEY) to client
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Product-Specific OAuth Callback (defaults automatically to ${SITE_URL}/auth/callback)
NEXT_PUBLIC_PRODUCT_CALLBACK_URL=https://ledgerlens.cevonx.com/auth/callback
